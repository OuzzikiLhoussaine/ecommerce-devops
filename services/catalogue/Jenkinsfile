// Pipeline CI/CD du microservice CATALOGUE.
// Cycle de version independant : ce pipeline ne touche UNIQUEMENT
// aux manifests et au deployment du catalogue. Panier et Commandes
// ne sont jamais recycles.
pipeline {
  agent any

  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  triggers {
    pollSCM('H/5 * * * *')   // declenche le pipeline sur commit dans le repo
  }

  environment {
    SERVICE = 'catalogue'
    SERVICE_DIR = 'services/catalogue'
    REGISTRY = 'localhost:5000'
    TEST_MONGO_PORT = '27017'
  }

  stages {
    stage('Resolve version') {
      steps {
        script {
          env.APP_VERSION = readFile("${env.SERVICE_DIR}/VERSION").trim()
          env.IMAGE = "${env.REGISTRY}/ecommerce/${env.SERVICE}"
          env.TAG = "v${env.APP_VERSION}-${env.BUILD_NUMBER}"
          echo "Microservice ${env.SERVICE} version ${env.APP_VERSION} -> ${env.IMAGE}:${env.TAG}"
        }
      }
    }

    stage('Tests') {
      // Mongo ephemerique cote hote : les tests d'integration
      // utilisent MONGO_URL=mongodb://host.docker.internal:27017
      steps {
        sh "docker rm -f mongo-test-${BUILD_NUMBER} > /dev/null 2>&1 || true"
        sh "docker run -d --name mongo-test-${BUILD_NUMBER} -p 0.0.0.0:${TEST_MONGO_PORT}:27017 mongo:7"
        sh "cd ${SERVICE_DIR} && npm install && MONGO_URL=mongodb://host.docker.internal:\${TEST_MONGO_PORT} npm test"
      }
      post {
        always {
          sh "docker rm -f mongo-test-${BUILD_NUMBER} > /dev/null 2>&1 || true"
        }
      }
    }

    stage('Build image Docker') {
      steps {
        sh "cd ${SERVICE_DIR} && docker build --build-arg APP_VERSION=${APP_VERSION} -t ${IMAGE}:${TAG} ."
        // Le tag arrete sur la version (v2.0.0-b14) sert a la demo
        sh "cd ${SERVICE_DIR} && docker tag ${IMAGE}:${TAG} ${IMAGE}:v${APP_VERSION}"
      }
    }

    stage('Push registre') {
      steps {
        sh "docker push ${IMAGE}:${TAG}"
        sh "docker push ${IMAGE}:v${APP_VERSION}"
      }
    }

    stage('Deploy Kubernetes') {
      steps {
        // 1) appliquer UNIQUEMENT les manifests de ce service
        //    (StatefulSet mongo + Deployment + Service catalogue)
        sh "kubectl apply -f ${SERVICE_DIR}/k8s/"
        // 2) mise a jour de l'image -> rollout du deployment CATALOGUE seul
        sh "kubectl -n ecommerce set image deployment/${SERVICE} ${SERVICE}=${IMAGE}:${TAG}"
        sh "kubectl -n ecommerce rollout status deployment/${SERVICE} --timeout=120s"
      }
    }
  }

  post {
    success {
      echo "SUCCES: ${SERVICE} ${TAG} deploye sur le cluster."
    }

  }
}
